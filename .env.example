# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials, and never prefix any
# of these with NEXT_PUBLIC_ — that would compile them into the browser bundle
# and expose them to anyone who opens devtools.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/birra
#
# Hosted (Neon / Supabase / Railway) — these require TLS, so keep sslmode=require:
# DATABASE_URL=postgresql://user:password@host.example.com/birra?sslmode=require

# ---------------------------------------------------------------------------
# Contact form notifications
# ---------------------------------------------------------------------------
# Where new inquiry emails are delivered. Still a placeholder pending
# confirmation from the client.
CONTACT_NOTIFY_EMAIL=contact@birra-group.com

# Resend API key. Without it the inquiry is logged to the server console
# instead of emailed — nothing breaks, the notification just isn't sent.
# RESEND_API_KEY=re_xxxxxxxx

# Sender address. Defaults to Resend's shared test sender
# (onboarding@resend.dev), which needs no DNS but can ONLY deliver to the
# address that owns the Resend account — fine for testing.
# For production, verify birra-group.com with the provider and set this to a
# real address on that domain; an unverified domain is rejected with a 403.
# CONTACT_FROM_EMAIL=website@birra-group.com

# ---------------------------------------------------------------------------
# Google Gemini (AI chat)
# ---------------------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey — no billing required.
# Server-side only: the browser talks to /api/chat, and only the server talks
# to Google, so this key never reaches the client. Do NOT prefix it with
# NEXT_PUBLIC_ — that would compile it into the browser bundle.
#
# Note: on Google's free tier, submitted data may be used to improve their
# products. Paid tiers exclude this. Worth confirming with the client before
# launch, since visitors may type company details into the chat.
GEMINI_API_KEY=
